[Unit]
Description=Pi Bell Slapper
After=network.target sound.target

[Service]
ExecStart=/usr/bin/python3 /opt/bell-slapper/server.py --data-dir /var/lib/bell-slapper
DynamicUser=yes
SupplementaryGroups=gpio audio
StateDirectory=bell-slapper
WorkingDirectory=/var/lib/bell-slapper
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
